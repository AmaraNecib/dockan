{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dokan",
  "version": "0.1.0",
  "identifier": "dz.dokan.app",
  "build": {
    "beforeDevCommand": "bun run --filter @dokan/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --filter @dokan/web build",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dokan",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}