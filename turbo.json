{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DOKAN_CUSTOMER_SLUG", "DOKAN_BUILD_SECRET", "DOKAN_AUTH_SECRET"],
  "globalPassThroughEnv": ["BUN_OPTIONS"],
  "globalDependencies": ["apps/desktop/.env", "apps/desktop/.env.*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
