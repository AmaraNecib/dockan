{
  "name": "mani-project",
  "private": true,
  "packageManager": "bun@1.4.3",
  "type": "module",
  "description": "Dokan — desktop stock & invoicing app for a car-accessories shop (Algeria). Tauri + TanStack + Hono, on Bun.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @dokan/api dev",
    "dev:web": "bun run --filter @dokan/web dev",
    "dev:up": "bun run --filter @dokan/api dev && bun run --filter @dokan/web dev",
    "dev:desktop": "bun run --filter @dokan/desktop dev",
    "desktop:sidecar": "bun run --filter @dokan/desktop sidecar",
    "desktop:portable": "bun run --filter @dokan/desktop portable",
    "desktop:installer": "bun run --filter @dokan/desktop installer",
    "build": "turbo build",
    "lint": "oxlint",
    "typecheck": "turbo typecheck && tsc -p scripts/tsconfig.json",
    "test": "turbo test --concurrency=2 && bun test ./scripts/",
    "skills:sync": "bun scripts/sync-claude-skills.ts",
    "skills:check": "bun scripts/sync-claude-skills.ts --check",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.85.0",
    "@playwright/test": "^1.62.1",
    "@shadcn/lint": "^0.2.0",
    "husky": "^9.1.7",
    "oxlint": "^1.85.0",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.1",
    "seroval": "^1.6.9",
    "seroval-plugins": "^1.6.9",
    "source-map-js": "^1.2.2",
    "undici": "^7.29.1"
  }
}
