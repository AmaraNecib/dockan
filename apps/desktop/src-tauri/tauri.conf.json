{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dokan",
  "version": "0.1.0",
  "identifier": "dz.dokan.app",
  "build": {
    "beforeDevCommand": "bun run --filter @dokan/web dev",
    "devUrl": "http://dokan.localhost:5173",
    "beforeBuildCommand": "bun run --filter @dokan/web build",
    "frontendDist": "../../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dokan",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/dokan-api"],
    "resources": {
      "../../../apps/web/dist": "ui"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}